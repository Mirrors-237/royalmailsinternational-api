# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=tic_user
DB_PASSWORD=tic_password
DB_NAME=tic_db

# JWT: in production at least 32 characters (e.g. openssl rand -hex 32)
JWT_SECRET=change_me_in_production_very_long_secret_key
JWT_EXPIRES_IN=7d

# App
PORT=3001
# production: the API refuses to start with missing secrets or the example values from this file
# (set by the Dockerfile)
NODE_ENV=development

# Demo content (shipments, quote requests, messages, testimonials, partners) inserted into an empty database.
# Default: true, except in production. Never enable it for the real website: the testimonials are made up.
# SEED_DEMO=false

# CORS: allowed origins, comma-separated
CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# Proxies whose X-Forwarded-For header is trusted (Express "trust proxy" syntax).
# Default: local and private-network addresses, i.e. the Nuxt server on the same host or Docker network.
# TRUST_PROXY=loopback, uniquelocal

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
# Bare address: the site name (admin settings) is used as the sender name
# "Name <address>": used as is
SMTP_FROM=your_email@gmail.com
SMTP_TO=admin@example.com

# First admin account, created when the database has no user yet; ignored afterwards
# (the password is then changed from the admin, Account page). Required for the first start.
# In production the password must be at least 12 characters and differ from this example.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@2024!

# Tracking
TRACKING_CODE_LENGTH=13

# S3-compatible storage (RustFS): logos and favicon
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=change_me
S3_BUCKET=tac-assets
