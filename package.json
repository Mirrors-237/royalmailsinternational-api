{
  "name": "tic-backend",
  "version": "1.0.0",
  "description": "Courier tracking platform – NestJS API",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "seed": "ts-node -r tsconfig-paths/register src/common/seed/seed.ts",
    "migration:generate": "nest build && typeorm migration:generate -d dist/config/data-source.js",
    "migration:check": "nest build && typeorm migration:generate -d dist/config/data-source.js --check src/migrations/Check",
    "migration:create": "typeorm migration:create",
    "migration:run": "nest build && typeorm migration:run -d dist/config/data-source.js",
    "migration:revert": "nest build && typeorm migration:revert -d dist/config/data-source.js",
    "migration:show": "nest build && typeorm migration:show -d dist/config/data-source.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^12.0.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dompurify": "^3.4.16",
    "jsdom": "^30.1.2",
    "nodemailer": "^10.0.16",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
